# Copy to .env (git-ignored).
# Use "groq" for the hosted provider or "ollama" for a local Ollama server.
LLM_PROVIDER=groq
GROQ_API_KEY=
# Used by Groq and Ollama when set. For Ollama, this should match a pulled model.
# ASSISTANT_MODEL=llama-3.3-70b-versatile
# OLLAMA_MODEL=llama3.1:8b
# OLLAMA_URL=http://127.0.0.1:11434
# Local RAG PostgreSQL + pgvector storage.
# RAG_DATABASE_URL=postgresql://evo:evo_local_dev@localhost:5433/evostrategy
